# Visual Studio settings, caches and per-user files (VS 2017 and later keep their caches in .vs/)
.vs/
*.user

# C++ build output: x64 builds go to x64/, Win32 builds to Debug/ and Release/
x64/
[Dd]ebug/
[Rr]elease/

# Python and Jupyter
__pycache__/
.ipynb_checkpoints/
.venv/
venv/

# Training data and artifacts (training/ is the notebook's DATA_DIR locally)
training/game_logs/
training/training_data.csv
training/*.h5
training/*.pt

# Windows
Thumbs.db
desktop.ini
